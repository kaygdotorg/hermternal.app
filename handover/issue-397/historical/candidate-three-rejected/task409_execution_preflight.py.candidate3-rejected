class Reject(Exception):
    """A deliberate, fail-closed input or artifact rejection."""


def reject(message: str) -> None:
    raise Reject(message)


def require(condition: bool, message: str) -> None:
    if not condition:
        reject(message)


def require_equal(left: Any, right: Any, label: str) -> None:
    if left != right:
        reject(f"{label} differs")


def _identity(st: os.stat_result) -> dict[str, int]:
    """Capture fields that identify the approved regular file, not its timestamp.

    Timestamps can change as a filesystem records access or metadata activity.
    Device, inode, owner, mode, size, and link count are the stable fields needed
    to detect replacement or sharing while preserving the supplied approval data.
    """
    return {
        "st_dev": int(st.st_dev),
        "st_ino": int(st.st_ino),
        "st_uid": int(st.st_uid),
        "st_gid": int(st.st_gid),
        "st_mode": int(stat.S_IMODE(st.st_mode)),
        "st_size": int(st.st_size),
        "st_nlink": int(st.st_nlink),
    }


def _safe_read(path: Path, label: str) -> tuple[bytes, os.stat_result]:
    try:
        return PARITY.read_stable(path)
    except SystemExit as exc:
        reject(f"{label}: {exc}")
    raise AssertionError("unreachable")


def read_twice(path: Path, label: str) -> tuple[bytes, os.stat_result]:
    """Read exact bytes twice and require the descriptor identity to be stable."""
    first, first_stat = _safe_read(path, label)
    second, second_stat = _safe_read(path, label)
    require(first == second, f"{label} bytes changed during preflight")
    require(_identity(first_stat) == _identity(second_stat), f"{label} identity changed during preflight")
    return first, first_stat


def canonical_absolute(value: Any, label: str) -> Path:
    require(isinstance(value, str) and value, f"{label} must be a nonempty string")
    path = Path(value)
    require(path.is_absolute(), f"{label} must be an absolute path")
    require(str(path) == os.path.realpath(str(path)), f"{label} must already be canonical")
    return path


def parse_json(raw: bytes, label: str) -> dict[str, Any]:
    try:
        value = json.loads(raw.decode("utf-8"))
    except Exception as exc:
        reject(f"{label} JSON parse failed: {exc}")
    require(isinstance(value, dict), f"{label} JSON root must be an object")
    return value


def obj(document: Mapping[str, Any], *keys: str, label: str | None = None) -> Any:
    value: Any = document
    for key in keys:
        require(isinstance(value, dict) and key in value, label or f"missing JSON path /{'/'.join(keys)}")
        value = value[key]
    return value


def exact_sha(value: Any, label: str) -> str:
    require(isinstance(value, str) and SHA256_RE.fullmatch(value) is not None, f"{label} must be 64 lowercase hexadecimal characters")
    return value


def exact_oid(value: Any, label: str, width: int) -> str:
    require(isinstance(value, str) and len(value) == width and OID_RE.fullmatch(value) is not None, f"{label} must be exactly {width} lowercase hexadecimal characters")
    return value


def validate_ref(value: Any, label: str) -> str:
    require(isinstance(value, str) and REF_RE.fullmatch(value) is not None, f"{label} must be a direct refs/heads name")
    require(".." not in value and "@{" not in value, f"{label} contains traversal or reflog syntax")
    require(not value.endswith((".", "/")), f"{label} has an invalid suffix")
    require(not any(part in {"", ".", ".."} for part in value[len("refs/heads/") :].split("/")), f"{label} has an empty or traversal component")
    require(not any(part.endswith(".lock") for part in value.split("/")), f"{label} contains a lock-suffixed component")
    return value


def validate_identity(value: Any, expected: dict[str, int], label: str) -> None:
    require(isinstance(value, dict), f"{label} identity must be an object")
    require(set(value) == set(IDENTITY_FIELDS), f"{label} identity fields differ")
    for field in IDENTITY_FIELDS:
        item = value[field]
        require(isinstance(item, int) and not isinstance(item, bool) and item >= 0, f"{label} identity field {field} must be a nonnegative integer")
    require(value == expected, f"{label} identity does not match the freshly read file")
    require(value["st_nlink"] == 1, f"{label} must have exactly one hard link")


def require_literal(raw: bytes, literal: str, label: str) -> None:
    require(literal.encode("utf-8") in raw, f"Markdown is missing {label}: {literal}")


def _context_has_nonexecution(text: str, token: str) -> bool:
    """Allow stale history only when prose explicitly forbids using it."""
    lowered = text.lower()
    for match in re.finditer(re.escape(token.lower()), lowered):
        context = lowered[max(0, match.start() - 220) : match.end() + 280]
        if any(word in context for word in ("stale", "non-authoritative", "do not execute", "never reuse", "ignore", "rejected")):
            continue
        return False
    return True


def check_stale_references(md_raw: bytes, json_raw: bytes, shell: bytes, stale_paths: Sequence[str], stale_hashes: Sequence[str]) -> None:
    """Reject old executable bindings while permitting explicit historical notes."""
    paths = list(stale_paths)
    hashes = list(stale_hashes)
    require(len(paths) == len(set(paths)), "stale path list contains duplicates")
    require(len(hashes) == len(set(hashes)), "stale hash list contains duplicates")
    for required in MANDATORY_STALE_PATHS:
        require(required in paths, f"manifest omits mandatory stale path: {required}")
    for required in MANDATORY_STALE_HASHES:
        require(required in hashes, f"manifest omits mandatory stale hash: {required}")

    md_text = md_raw.decode("utf-8", "strict")
    json_text = json_raw.decode("utf-8", "strict")
    shell_text = shell.decode("utf-8", "strict")
    for token in [*paths, *hashes]:
        require(token not in shell_text, f"stale token appears in executable shell: {token}")
        # A stale standalone path may be retained in JSON only as an explicit
        # rejection record. Superseded matrix paths and old binding hashes must
        # not survive in machine-readable data at all.
        if token in MANDATORY_STALE_PATHS[1:] or token in MANDATORY_STALE_HASHES:
            require(token not in json_text, f"superseded token appears in JSON metadata: {token}")
        elif token in json_text:
            require(any(word in json_text.lower() for word in ("stale", "non-authoritative", "do not execute", "never reuse", "rejected")), f"stale JSON path lacks explicit non-execution context: {token}")
        require(_context_has_nonexecution(md_text, token), f"stale token appears in Markdown without explicit non-execution context: {token}")

    # These phrases catch a stale source-of-truth declaration even when the old
    # path was not copied into the manifest's historical list.
    for phrase in (
        '"source_of_truth": "/private/tmp/hermternal-task409-approved-driver.sh"',
        "execute /private/tmp/hermternal-task409-approved-driver.sh",
        "reuse /private/tmp/hermternal-task409-approved-driver.sh",
    ):
        require(phrase not in md_text and phrase not in json_text and phrase not in shell_text, f"stale active reference found: {phrase}")


def check_identity_declarations(md_raw: bytes, normalized_sha: str) -> None:
    declarations = PARITY.markdown_identity_declarations(md_raw)
