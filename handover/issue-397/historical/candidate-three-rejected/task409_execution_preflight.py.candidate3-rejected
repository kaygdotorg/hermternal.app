def check_artifact_paths(document: dict[str, Any], markdown: Path, json_path: Path, shell: Path) -> None:
    paths = obj(document, "artifact_paths")
    require(isinstance(paths, dict), "artifact_paths must be an object")
    require(paths.get("markdown") == str(markdown), "JSON Markdown artifact path differs from supplied path")
    require(paths.get("json") == str(json_path), "JSON matrix artifact path differs from supplied path")
