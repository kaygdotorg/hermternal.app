{
  "name": "@hermternal/typescript-contract-parity",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run test",
    "typecheck": "bun ./node_modules/@typescript/native/bin/tsc --project tsconfig.json --pretty false --noEmit",
    "compile": "bun ./node_modules/@typescript/native/bin/tsc --project tsconfig.build.json --pretty false",
    "test": "bun test tests",
    "parity": "bun src/cli.ts --repo-root ../.."
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "bun-types": "1.3.14"
  }
}
