{
  "schema_version": "pty-detach-race-v1",
  "contract": {
    "route": "WS /api/pty",
    "surface": "web-only",
    "proof_mode": "offline-synthetic-pty-lifecycle",
    "scope": "C-18",
    "source_of_truth": [
      "contracts/state-models/terminal.md",
      "contracts/fixtures/source-audit/pty-attach/README.md"
    ],
    "detach_rule": "reattach allowed when elapsed <= 1800; expired when elapsed > 1800",
    "replay_rule": "newest-1MiB-pty-output-only; retained-live-race-allowed",
    "resize_rule": "integer clamp then exact binary resize frame",
    "logging_rule": "no-pty-bytes-or-action-payloads"
  },
  "constants": {
    "resize_prefix_hex": "1b5b524553495a453a",
    "resize_suffix_hex": "5d",
    "min_cols": 1,
    "max_cols": 2000,
    "min_rows": 1,
    "max_rows": 1000,
    "replay_capacity_bytes": 1048576,
    "detach_retention_seconds": 1800,
    "registry_max_entries": 16,
    "replacement_close_code": 4409,
    "process_exit_close_code": 4410
  },
  "evidence": {
    "accessibility": {
      "status": "not-applicable",
      "reason": "Protocol-only fixture; no UI nodes or interaction code changed.",
      "preservation_reference": "contracts/state-models/terminal.md"
    },
    "security": {
      "status": "pass",
      "synthetic_only": true,
      "live_integration": false,
      "raw_pty_bytes_logged": false,
      "action_payloads_replayed": false
    },
    "benchmark": {
      "status": "baseline-only",
      "artifact": "validation-baseline.json",
      "approved_budget": null,
      "normal_samples": 30,
      "optimized_samples": 30,
      "threshold": null
    }
  },
  "cases": [
    {
      "id": "detach-ttl",
      "kind": "detach-ttl",
      "input": {
        "handle_ref": "synthetic-handle-ttl",
        "session_ref": "synthetic-session-ttl",
        "process_ref": "synthetic-process-ttl",
        "detached_state": "detached",
        "probes": [
          {
            "elapsed_seconds": 1799,
            "outcome": "reattach-allowed"
          },
          {
            "elapsed_seconds": 1800,
            "outcome": "reattach-allowed"
          },
          {
            "elapsed_seconds": 1801,
            "outcome": "reattach-expired"
          }
        ]
      },
      "expected": {
        "retention_seconds": 1800,
        "predicate": "elapsed <= retention_seconds",
        "state_sequence": [
          "attached",
          "detached",
          "reattached",
          "expired"
        ],
        "expired_only_after": 1800
      }
    },
    {
