      "lines": "92-95",
      "marker": "truncated = (ticket[:8] + \"…\") if ticket else \"<empty>\"",
      "claim": "The pinned ticket store constructs a short ticket fragment in the invalid-ticket exception, which is attacker-derived source text and must not be retained by the fixture."
    },
