      "marker": "supports_password = True",
      "claim": "The Basic provider is password-capable, uses generic invalid-credential failure, and returns a provider session from complete_password_login."
    },
    {
      "id": "basic-provider-refresh",
      "file": "plugins/dashboard_auth/basic/__init__.py",
      "lines": "273-283",
      "marker": "def refresh_session",
      "claim": "A valid protected refresh credential can mint a new Basic provider session; invalid or expired refresh material fails closed."
    },
    {
      "id": "password-login-route",
      "file": "hermes_cli/dashboard_auth/routes.py",
      "lines": "650-739",
      "marker": "@router.post(\"/auth/password-login\", name=\"auth_password_login\")",
      "claim": "Password login distinguishes rate limiting, unknown providers, invalid credentials, provider misconfiguration, provider outage, and successful session-cookie issuance."
    },
    {
