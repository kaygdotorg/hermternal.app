      "id": "ws-ticket-audit-forward",
      "file": "hermes_cli/web_server.py",
      "lines": "14708-14716",
      "marker": "reason=str(exc),",
      "claim": "The gated WebSocket path forwards the ticket exception string as an audit reason, so retained history, logs, and DOM-visible errors must contain no ticket fragment."
    },
