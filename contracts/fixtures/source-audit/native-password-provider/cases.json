      "kind": "login",
      "request": {"method": "POST", "path": "/auth/password-login", "provider_state": "unknown", "credential_state": "not_attempted", "transport": "https", "cookie_store": "native_isolated"},
      "expected": {"http_status": 404, "session_cookie": "absent", "refresh_cookie": "absent", "provider_cookie": "absent", "error_shape": "generic_unknown_provider", "password_retained": false}
    },
