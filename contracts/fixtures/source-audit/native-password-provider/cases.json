      "kind": "login",
      "request": {"method": "POST", "path": "/auth/password-login", "provider_state": "registered_password", "credential_state": "valid", "transport": "https", "cookie_store": "native_isolated"},
      "expected": {"http_status": 200, "session_cookie": "issued", "refresh_cookie": "issued", "provider_cookie": "issued", "rest_auth": "native_cookie", "password_retained": false}
    },
    {
      "id": "login-wrong-password",
      "kind": "login",
      "request": {"method": "POST", "path": "/auth/password-login", "provider_state": "registered_password", "credential_state": "wrong_password", "transport": "https", "cookie_store": "native_isolated"},
      "expected": {"http_status": 401, "session_cookie": "absent", "refresh_cookie": "absent", "provider_cookie": "absent", "error_shape": "generic_invalid_credentials", "password_retained": false}
    },
    {
