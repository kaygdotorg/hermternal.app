      "kind": "ws_upgrade",
      "request": {"method": "GET", "path": "/api/ws", "auth_mode": "gated", "ticket_state": "reused", "cookie_state": "not_sent", "query_credential": "ticket_only"},
      "expected": {"decision": "reject_unknown_or_reused_ticket", "credential_source": "ephemeral_ticket", "cookie_on_upgrade": false, "ticket_consumed_once": true}
