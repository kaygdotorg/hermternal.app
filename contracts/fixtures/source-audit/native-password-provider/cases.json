      "kind": "cookie",
      "request": {"transport": "http", "deployment": "direct", "cookie_store": "native_isolated"},
      "expected": {"access_name": "hermes_session_at", "refresh_name": "hermes_session_rt", "provider_name": "hermes_session_provider", "secure": false, "httponly": true, "samesite": "lax", "path": "/", "domain": "absent"}
    },
    {
      "id": "cookie-https-host-prefix",
      "kind": "cookie",
      "request": {"transport": "https", "deployment": "direct", "cookie_store": "native_isolated"},
      "expected": {"access_name": "__Host-hermes_session_at", "refresh_name": "__Host-hermes_session_rt", "provider_name": "__Host-hermes_session_provider", "secure": true, "httponly": true, "samesite": "lax", "path": "/", "domain": "absent"}
    },
    {
