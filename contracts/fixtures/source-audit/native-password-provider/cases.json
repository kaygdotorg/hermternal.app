      "kind": "cookie",
      "request": {"transport": "https", "deployment": "direct", "refresh_material": "provider_omits_refresh", "cookie_store": "native_isolated"},
      "expected": {"access_cookie": "issued", "refresh_cookie": "not_written", "provider_cookie": "issued", "session_mode": "access_only_until_expiry"}
    },
    {
      "id": "cookie-app-isolated-store",
      "kind": "isolation",
      "request": {"client": "native", "cookie_store": "app_isolated_protected", "browser_store": "shared_browser_store"},
