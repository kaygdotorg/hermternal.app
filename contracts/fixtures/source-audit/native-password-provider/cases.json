    },
    {
      "id": "native-ws-expired-ticket-denied",
      "kind": "ws_upgrade",
      "request": {"method": "GET", "path": "/api/ws", "auth_mode": "gated", "ticket_state": "expired", "cookie_state": "not_sent", "query_credential": "ticket_only"},
