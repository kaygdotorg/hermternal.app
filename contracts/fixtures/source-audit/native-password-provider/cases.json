      "kind": "ws_upgrade",
      "request": {"method": "GET", "path": "/api/ws", "auth_mode": "gated", "ticket_state": "missing", "cookie_state": "not_sent", "query_credential": "none"},
      "expected": {"decision": "reject_missing_credential", "credential_source": "none", "cookie_on_upgrade": false}
    },
    {
      "id": "native-ws-malformed-ticket-denied",
      "kind": "ws_upgrade",
      "request": {"method": "GET", "path": "/api/ws", "auth_mode": "gated", "ticket_state": "malformed", "cookie_state": "not_sent", "query_credential": "ticket_only"},
