  "decision_rules": {
    "native_source_scope": "gated_auth_attempts_bearer_for_every_non_public_path",
    "native_supported_scope": "only_the_eight_reviewed_method_path_pairs_above",
    "native_supported_inventory_is_complete": false,
    "native_route_match": "exact_method_and_path_shape",
    "parameter_segment_rule": "{session_id} matches one non-empty path segment only",
    "valid_bearer": "pass_through_to_handler",
    "invalid_or_expired_bearer": "401_invalid_or_expired_session_even_when_valid_cookie_present",
    "missing_bearer_with_valid_cookie": "cookie_session_pass_through",
    "provider_stack_accept": "pass_through_even_if_another_provider_is_unreachable",
    "provider_stack_all_reachable_invalid": "401_invalid_or_expired_session",
    "provider_stack_no_accept_and_any_unreachable": "503_auth_provider_unreachable",
    "public_exact_path": "bypass_native_bearer_gate",
    "public_prefix": "bypass_native_bearer_gate_using_source_prefix_semantics",
    "service_token_registered": "token_auth_seam_owns_exact_drain_path_only",
    "service_token_unregistered": "token_auth_seam_passes_through; gated_or_legacy_session_gate_remains",
    "unverified_route": "blocked_unverified",
    "bearer_fallback": "never_fallback_to_cookie_after_present_bearer_fails"
  }
