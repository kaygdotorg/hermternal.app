      "claim": "Provider discovery and native authorize/token/refresh endpoints are public bootstrap or credential issuance/rotation routes."
    },
    {
      "file": "token_auth.py",
      "lines": "60-75",
      "claim": "The separate service-token seam registers exact paths and does not widen authentication to unregistered paths."
    },
    {
      "file": "token_auth.py",
